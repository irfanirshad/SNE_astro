</Layout>

<style>
	.feature-card__section {
		margin: var(--section-margin) auto;
	}
	.feature-card__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--theme-grid-gap);
	}
	@media (max-width: 768px) {
		.feature-card__grid {
			grid-template-columns: 1fr;
		}
	}

	/* Partner section container to ensure the images stay within bounds and slide smoothly */
.partner-section {
    overflow: hidden;
    white-space: nowrap;
    box-sizing: border-box;
    position: relative;
}

/* Slider that will be animated to create the sliding effect */
.slider {
    display: inline-block;
    animation: slide 20s linear infinite;
}

/* Individual columns for each partner image */
.column {
    display: inline-block;
    padding: 0 20px; /* Adjust padding as necessary */
}

/* Styling for images to ensure they fit well within their container */
.column img {
    height: 130px;
    width: auto; /* Maintain aspect ratio */
    object-fit: contain; /* Ensure the image fits within its container without distortion */
}

/* Keyframes to animate the slider from right to left */
@keyframes slide {
    0% {
        transform: translateX(100%);
    }
    100% {
        transform: translateX(-100%);
    }
}

/* Feature card section styling */
.feature-card__section {
    margin: var(--section-margin) auto;
}

/* Grid layout for feature cards */
.feature-card__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--theme-grid-gap);
}

/* Responsive adjustment for smaller screens */
@media (max-width: 768px) {
    .feature-card__grid {
        grid-template-columns: 1fr;
    }
}

.google-review__grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: var(--theme-grid-gap);
}

.google-review__card {
	background-color: var(--theme-surface-1);
	color: var(--theme-on-surface-1);
	border-radius: var(--theme-shape-radius);
	padding: 1.5rem;
}

.google-review__header {
	display: flex;
	align-items: flex-start;
	gap: 0.85rem;
	margin-bottom: 1rem;
}

.google-review__avatar {
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 2.75rem;
	height: 2.75rem;
	border-radius: 50%;
	background-color: var(--theme-surface-2);
	color: var(--theme-on-surface-2);
	font-family: var(--theme-font-family-sans);
	font-weight: 700;
}

.google-review__name {
	margin: 0 0 0.15rem 0;
	font-weight: 700;
	font-size: 0.95rem;
}

.google-review__stars {
	color: #f5a623;
	letter-spacing: 0.05em;
	font-size: 0.9rem;
}

.google-review__logo {
	margin-left: auto;
	width: 1.35rem;
	height: 1.35rem;
	flex-shrink: 0;
}

.google-review__text {
	margin: 0;
	font-size: 0.95rem;
	line-height: 1.5;
	opacity: 0.85;
}

.google-review__cta {
	display: inline-flex;
	align-items: center;
	gap: 0.25rem;
	margin-top: 1.5rem;
	font-weight: 700;
	color: var(--theme-primary);
	text-decoration: none;
}
.google-review__cta :global(svg) {
	width: 1rem;
	height: 1rem;
}

@media (max-width: 768px) {
	.google-review__grid {
		grid-template-columns: 1fr;
	}
}

.trust-section__subtitle {
	margin-top: -0.5rem;
	margin-bottom: 1.5rem;
	color: var(--theme-on-surface-1, currentColor);
	opacity: 0.7;
}

.trust-card__grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: var(--theme-grid-gap);
	align-items: stretch;
}

.trust-card {
	display: flex;
	flex-direction: column;
	background-color: var(--theme-surface-1);
	color: var(--theme-on-surface-1);
	border-radius: var(--theme-shape-radius);
	padding: 1.5rem;
	text-decoration: none;
}

a.trust-card--link {
	transition: transform var(--theme-transition), box-shadow var(--theme-transition);
}
a.trust-card--link:hover {
	transform: translateY(-0.25rem);
	box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.1);
}

.trust-card__badge {
	display: inline-flex;
	align-self: flex-start;
	align-items: center;
	font-family: var(--theme-font-family-sans);
	font-weight: 700;
	font-size: 0.8rem;
	letter-spacing: 0.02em;
	padding: 0.3rem 0.75rem;
	border-radius: 2rem;
	color: #fff;
	margin-bottom: 1rem;
}
.trust-card__badge--magicbricks {
	background-color: #d1372f;
}
.trust-card__badge--justdial {
	background-color: #1baa5c;
}
.trust-card__badge--propertywala {
	background-color: #0f7c8c;
}

.trust-card__agent {
	display: flex;
	align-items: center;
	gap: 0.85rem;
	margin-bottom: 1.25rem;
}
.trust-card__avatar {
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 3rem;
	height: 3rem;
	border-radius: 50%;
	background-color: var(--theme-surface-2);
	color: var(--theme-on-surface-2);
	font-family: var(--theme-font-family-sans);
	font-weight: 700;
}
.trust-card__agent-name {
	font-weight: 700;
	margin: 0;
}
.trust-card__agent-company {
	margin: 0;
	opacity: 0.75;
	font-size: 0.9rem;
}
.trust-card__agent-company--lg {
	font-size: 1.1rem;
	font-weight: 700;
	opacity: 1;
	margin-bottom: 0.5rem;
}

.trust-card__stats {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1rem;
	margin: auto 0 0 0;
	padding-top: 1rem;
	border-top: 1px solid rgba(0, 0, 0, 0.08);
}
.trust-card__stats--compact {
	border-top: none;
	padding-top: 0;
	margin-top: 0.25rem;
}
.trust-card__stats dt {
	font-size: 0.75rem;
	opacity: 0.6;
	margin-bottom: 0.15rem;
}
.trust-card__stats dd {
	margin: 0;
	font-weight: 700;
	font-size: 0.9rem;
}

.trust-card__rating {
	display: flex;
	align-items: center;
	gap: 0.4rem;
	margin-bottom: 0.75rem;
	font-weight: 700;
}
.trust-card__stars {
	color: #f5a623;
	letter-spacing: 0.05em;
}

.trust-card__meta {
	margin: 0 0 0.35rem 0;
	font-size: 0.9rem;
	opacity: 0.75;
}

.trust-card__dot {
	opacity: 0.6;
}

.trust-card__cta {
	display: inline-flex;
	align-items: center;
	gap: 0.25rem;
	margin-top: 1rem;
	font-weight: 700;
	color: var(--theme-primary);
}
.trust-card__cta :global(svg) {
	width: 1rem;
	height: 1rem;
}

@media (max-width: 768px) {
	.trust-card__grid {
		grid-template-columns: 1fr;
	}
}

</style>
